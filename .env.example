# Free-only defaults for DARK ATLAS
LLM_PROVIDER=rule_based
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Indonesian male narrator; no API key required
EDGE_TTS_VOICE=id-ID-ArdiNeural
EDGE_TTS_RATE=-15%
KOKORO_MODEL_PATH=

# Free footage search; falls back to FFmpeg-generated motion visuals
VIDEO_PROVIDER=stock
DOCKER_VIDEO_URL=http://localhost:8188
HF_API_TOKEN=
REPLICATE_API_TOKEN=
FAL_API_KEY=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_DIR=output
TEMP_DIR=output/.tmp
LOG_LEVEL=INFO

SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_SIZE=24
SUBTITLE_COLOR=FFFFFF
SUBTITLE_OUTLINE_COLOR=000000
SUBTITLE_OUTLINE_WIDTH=2
